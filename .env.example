# Copy to .env.local for local dev; same keys go in Vercel env vars for prod.
DROPPY_MAIN_URL=https://script.google.com/macros/s/XXXXXXXX/exec
DROPPY_ADMIN_KEY=your-admin-key-here

# No per-account key needed — capacity_() on the storage scripts isn't gated.
DROPPY_STORAGE_ACCOUNTS=[{"label":"Storage 1","url":"https://script.google.com/macros/s/YYYYYYYY/exec"}]

# Shared password for the dashboard login (required — the app refuses to
# serve without it). SESSION_SECRET signs session cookies; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_PASSWORD=
SESSION_SECRET=
